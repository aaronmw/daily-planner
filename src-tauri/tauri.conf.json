{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Daily Planner",
    "version": "1.0.0",
    "identifier": "com.aaronwright.dailyplanner",
    "build": {
        "beforeBuildCommand": "pnpm desktop:migration:build",
        "frontendDist": "migration-dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Daily Planner",
                "url": "https://aaronmw.github.io/daily-planner/",
                "width": 1440,
                "height": 960,
                "minWidth": 960,
                "minHeight": 640,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "capabilities": ["main-capability", "legacy-migration-capability"],
            "csp": "default-src 'none'; script-src 'self'; connect-src ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "targets": "all"
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["daily-planner"]
            }
        }
    }
}
