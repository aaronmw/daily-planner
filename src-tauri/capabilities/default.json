{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "main-capability",
    "description": "Exact native permissions for the hosted Daily Planner origin",
    "local": false,
    "remote": {
        "urls": [
            "https://aaronmw.github.io/daily-planner",
            "https://aaronmw.github.io/daily-planner/*"
        ]
    },
    "windows": ["main"],
    "permissions": [
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "core:window:allow-set-focus",
        "core:window:allow-show",
        "core:window:allow-unminimize",
        "deep-link:allow-get-current",
        "global-shortcut:allow-is-registered",
        "global-shortcut:allow-register",
        "global-shortcut:allow-unregister",
        "notification:allow-is-permission-granted",
        "notification:allow-request-permission",
        "notification:allow-notify",
        {
            "identifier": "opener:allow-open-url",
            "allow": [
                {
                    "url": "https://xgubpuynmcjscfxosplr.supabase.co/auth/v1/authorize*"
                }
            ]
        },
        "allow-dock-icon-accent",
        "allow-hosted-migration"
    ]
}
