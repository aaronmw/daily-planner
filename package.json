{
    "name": "daily-planner",
    "version": "1.0.0",
    "description": "A local-first, encrypted daily planner for web and macOS.",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.22.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "pnpm tauri:dev",
        "dev:web": "sh -c 'exec vite \"$@\" --host 127.0.0.1 --port 3010 --strictPort' --",
        "dev:lan": "node scripts/dev-lan.mjs --port 3010 --local-url https://daily-planner.localhost -- pnpm dev:web",
        "dev:desktop": "vite --host 127.0.0.1 --port 1420 --strictPort",
        "build": "pnpm typecheck && vite build",
        "desktop:migration:build": "vite build --config vite.migration.config.ts",
        "icons:generate": "node scripts/generate-app-icons.mjs",
        "preview": "sh -c 'exec vite preview \"$@\" --host 127.0.0.1 --port 3010 --strictPort' --",
        "typecheck": "tsc -b",
        "lint": "eslint src vite.config.ts vite.migration.config.ts vitest.config.ts eslint.config.ts --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --project unit --project node",
        "test:browser": "vitest run --project browser",
        "test:coverage": "vitest run --coverage",
        "test:desktop-workflow": "node --test scripts/__tests__/*.test.mjs",
        "desktop:install": "node scripts/install-desktop-app.mjs",
        "setup:macos-signing": "node scripts/setup-macos-signing.mjs",
        "setup:macos-notarization": "node scripts/setup-macos-notarization.mjs",
        "tauri": "tauri",
        "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
        "tauri:build": "node scripts/build-tauri-app.mjs",
        "tauri:release": "pnpm tauri:build && pnpm desktop:install",
        "clean": "node scripts/clean-build-artifacts.mjs all",
        "clean:web": "node scripts/clean-build-artifacts.mjs web",
        "clean:rust:dev": "node scripts/clean-build-artifacts.mjs rust-dev",
        "clean:rust:release": "node scripts/clean-build-artifacts.mjs rust-release",
        "supabase": "supabase"
    },
    "dependencies": {
        "@dicebear/core": "10.6.0",
        "@dicebear/styles": "10.5.0",
        "@radix-ui/react-tooltip": "1.2.16",
        "@supabase/supabase-js": "2.112.3",
        "@tanstack/react-virtual": "3.14.9",
        "@tauri-apps/api": "2.11.1",
        "@tauri-apps/plugin-deep-link": "2.4.9",
        "@tauri-apps/plugin-global-shortcut": "2.3.2",
        "@tauri-apps/plugin-notification": "2.3.3",
        "@tauri-apps/plugin-opener": "2.5.4",
        "dexie": "4.4.5",
        "fractional-indexing": "4.0.0",
        "mdast-util-from-markdown": "2.0.3",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-markdown": "10.1.0",
        "react-router-dom": "7.18.2",
        "unist-util-visit": "5.1.0",
        "zod": "4.4.3",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@tailwindcss/postcss": "4.3.3",
        "@tauri-apps/cli": "2.11.4",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.4",
        "@types/eslint-plugin-jsx-a11y": "6.10.1",
        "@types/node": "25.9.5",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "@vitest/browser-playwright": "4.1.10",
        "@vitest/coverage-v8": "4.1.10",
        "eslint": "10.8.1",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "fake-indexeddb": "6.2.5",
        "jsdom": "29.1.1",
        "playwright": "1.62.1",
        "postcss": "8.5.26",
        "prettier": "3.9.6",
        "supabase": "2.114.0",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.12",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0",
        "vite": "8.2.1",
        "vitest": "4.1.10"
    },
    "prettier": {
        "arrowParens": "avoid",
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": true,
        "singleQuote": true,
        "printWidth": 80,
        "quoteProps": "consistent"
    }
}
