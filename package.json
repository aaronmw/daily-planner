{
    "name": "daily-planner",
    "version": "1.0.0",
    "description": "A local-first, encrypted daily planner for web and macOS.",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.16.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "pnpm tauri:dev",
        "dev:web": "vite --host 127.0.0.1 --port 3010 --strictPort",
        "dev:desktop": "vite --host 127.0.0.1 --port 1420 --strictPort",
        "build": "pnpm typecheck && vite build",
        "desktop:build": "vite build",
        "icons:generate": "node scripts/generate-app-icons.mjs",
        "preview": "vite preview --host 127.0.0.1 --port 3010 --strictPort",
        "typecheck": "tsc -b",
        "lint": "eslint src vite.config.ts vitest.config.ts eslint.config.ts --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --project unit --project node",
        "test:browser": "vitest run --project browser",
        "test:coverage": "vitest run --coverage",
        "test:desktop-workflow": "node --test scripts/__tests__/*.test.mjs",
        "desktop:install": "node scripts/install-desktop-app.mjs",
        "setup:macos-signing": "node scripts/setup-macos-signing.mjs",
        "tauri": "tauri",
        "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
        "tauri:build": "node scripts/build-tauri-app.mjs",
        "tauri:release": "pnpm tauri:build && pnpm desktop:install",
        "clean": "node scripts/clean-build-artifacts.mjs all",
        "clean:web": "node scripts/clean-build-artifacts.mjs web",
        "clean:rust:dev": "node scripts/clean-build-artifacts.mjs rust-dev",
        "clean:rust:release": "node scripts/clean-build-artifacts.mjs rust-release",
        "supabase": "supabase"
    },
    "dependencies": {
        "@dicebear/core": "^10.4.0",
        "@dicebear/styles": "^10.4.0",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@supabase/supabase-js": "^2.112.2",
        "@tanstack/react-virtual": "^3.14.9",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-deep-link": "^2.4.9",
        "@tauri-apps/plugin-fs": "^2.5.1",
        "@tauri-apps/plugin-global-shortcut": "^2.3.2",
        "@tauri-apps/plugin-notification": "^2.3.3",
        "@tauri-apps/plugin-opener": "^2.5.4",
        "dexie": "^4.4.4",
        "fractional-indexing": "4.0.0",
        "mdast-util-from-markdown": "^2.0.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.18.2",
        "unist-util-visit": "^5.1.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tauri-apps/cli": "^2.11.4",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/node": "^25.3.5",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.8.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^29.0.0",
        "playwright": "^1.58.2",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "supabase": "2.113.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.21.0",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.66.0",
        "vite": "8.2.1",
        "vitest": "^4.1.10"
    },
    "prettier": {
        "arrowParens": "avoid",
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": true,
        "singleQuote": true,
        "printWidth": 80,
        "quoteProps": "consistent"
    }
}
